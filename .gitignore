# ===== douyin-live-gmv-export =====
# 浏览器持久化 profile:包含登录凭据 / 会话 Cookie,严禁提交
data/browser_profile/

# 多账号:data/accounts/<名字>/browser_profile 同样是登录凭据目录(以及账号登记 json),整体忽略
data/accounts/

# 用户本地配置(可含个人覆盖);模板见 config.example.yaml
config.yaml

# 探测证据与输出产物(可能含账号权限范围内的聚合数据)
data/probe/*.json
data/output*/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# 输入法(如搜狗)在程序工作目录写下的日志(开图形界面时可能出现)
debug.log

# 编辑器 / 系统
.idea/
.vscode/
Thumbs.db
.DS_Store
